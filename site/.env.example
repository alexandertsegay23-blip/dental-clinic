# ===========================================
# DENTAL CLINIC WEBSITE - ENVIRONMENT VARS
# ===========================================
# Copy this file to .env.local and fill in your values

# ===========================================
# ADMIN SECURITY (REQUIRED)
# ===========================================
# These create the default admin account
# CHANGE THESE AFTER FIRST LOGIN!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YourSecurePassword123!

# ===========================================
# SESSION SECURITY (RECOMMENDED)
# ===========================================
# Generate a random string for additional session security
# Example: openssl rand -base64 32
SESSION_SECRET=your-session-secret-here

# ===========================================
# SMS CONFIGURATION (AFROMESSAGE)
# ===========================================
# Get these from https://afromessage.com
AFROMESSAGE_API_KEY=your-api-key-here
AFROMESSAGE_SENDER_ID=YourClinic
AFROMESSAGE_BASE_URL=https://api.afromessage.com/api

# ===========================================
# DATABASE (SQLite - Local)
# ===========================================
# These are automatic for local SQLite, but for production use PostgreSQL/MySQL
DATABASE_URL=file:./dev.db

# ===========================================
# DEPLOYMENT
# ===========================================
# For Vercel/Production - replace with your actual domain
NEXT_PUBLIC_SITE_URL=https://your-clinic-domain.com

# ===========================================
# RATE LIMITING
# ===========================================
# Number of login attempts allowed per IP
LOGIN_RATE_LIMIT=5
# Time window in seconds
LOGIN_RATE_WINDOW=300
